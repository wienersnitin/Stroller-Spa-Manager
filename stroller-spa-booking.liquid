{% comment %}
Stroller Spa booking section for Shopify Online Store 2.0.
Set backend URL in theme editor. Without backend, form is disabled to prevent losing bookings.
Package purchase buttons point to merchant-configured Shopify products.
{% endcomment %}
<section id="spa-{{ section.id }}" class="spa-wrap" data-api="{{ section.settings.api_url | escape }}">
  <div class="spa-hero"><div><span class="spa-eyebrow">WIENERS BABY & KIDS · PROFESSIONAL BABY GEAR CARE</span><h1>Stroller <em>Spa</em></h1><p>Clean gear. Happy baby. Professional cleaning, careful handling and convenient bookings across Delhi NCR.</p><div class="spa-hero-links"><a href="#spa-book-{{ section.id }}" class="spa-btn">Book a service</a><a class="spa-btn spa-outline" href="#spa-plans-{{ section.id }}">View care plans</a></div></div><div class="spa-hero-art" aria-hidden="true"><span>✦</span><div>🍼<br>🛒<br>✨</div></div></div>
  <div class="spa-features"><span>✓ Baby-safe cleaning products</span><span>✓ Steam & UV where appropriate</span><span>✓ Pickup & drop available</span><span>✓ Cleaning & repair support</span></div>
  <div class="spa-layout"><div><h2>Cleaning prices</h2><p class="spa-muted">Fixed Essential rates and clear Deep Cleaning options. Additional services are quoted separately.</p><div class="spa-price-grid">
    <article><h3>Stroller</h3><div>Essential <strong>₹1,999</strong></div><div>Deep <strong>₹2,499 onwards</strong></div></article>
    <article><h3>Bouncers, rockers, walkers & infant carry car seats</h3><div>Essential <strong>₹1,299</strong></div><div>Deep <strong>₹1,999</strong></div></article>
    <article><h3>Car seats (Groups 1–3) & bassinets</h3><div>Essential <strong>₹1,299</strong></div><div>Deep <strong>₹1,999</strong></div></article>
    <article><h3>Adjustable high chair</h3><div>Essential <strong>₹1,499</strong></div><div>Deep <strong>₹2,299</strong></div></article>
    <article><h3>Wooden high chair</h3><div>Essential <strong>₹1,799</strong></div><div>Deep <strong>Quote after inspection</strong></div></article>
    <article><h3>Mother's bag / Baby nest / Sleeping bag</h3><div>Essential <strong>₹599 / ₹699 / ₹699</strong></div><div>Deep <strong>Quote after inspection</strong></div></article>
    <article><h3>Soft toys & other gear</h3><div>Cleaning <strong>Quote by size and material</strong></div></article>
    <article><h3>Repairs & ride-on toys</h3><div>Inspection <strong>₹299 (adjustable)</strong></div><div>Repairs <strong>From ₹499 + parts</strong></div></article>
  </div><div class="spa-note">Essential: surface cleaning, light spot cleaning and general care. Deep: suitable fabric wash, detailed cleaning and steam/UV treatments where material and manufacturer guidance permit. Typical turnaround: Essential 2–3 days; Deep 4–5 days.</div></div>
  <aside id="spa-book-{{ section.id }}" class="spa-book"><h2>Book a cleaning</h2><p class="spa-muted">Share your gear and preferred date. Our team will confirm availability and any additional charges.</p><form class="spa-form" novalidate><label>Full name<input name="name" required maxlength="120" autocomplete="name"></label><label>Mobile / WhatsApp<input name="phone" required pattern="[0-9+() -]{10,18}" inputmode="tel" autocomplete="tel"></label><label>Email (optional)<input name="email" type="email" autocomplete="email"></label><label>Product category<select name="category" required><option value="">Select product</option><option>Stroller</option><option>Travel System (Stroller + Infant Car Seat)</option><option>Infant Carry Car Seat (0 / 0+)</option><option>Car Seat Group 1–3</option><option>Bassinet</option><option>Bouncer / Rocker</option><option>Walker</option><option>Adjustable High Chair</option><option>Wooden High Chair</option><option>Mother's Bag</option><option>Baby Nest / Sleeping Bag</option><option>Soft Toy</option><option>Ride-on / Battery-operated Toy</option><option>Other Baby Gear</option></select></label><label>Service<select name="service" required><option value="">Choose service</option><option value="essential">Essential Cleaning</option><option value="deep">Deep Cleaning</option><option value="repair">Repair / Inspection</option><option value="membership">Redeem Membership Service</option></select></label><label>Brand / model<input name="model" maxlength="150"></label><label>Preferred date<input name="preferred_date" type="date" required></label><label>Fulfilment<select name="fulfilment"><option value="dropoff">Store drop-off</option><option value="pickup">Request pickup (extra charge)</option></select></label><label>Membership ID (if applicable)<input name="membership_id" maxlength="60"></label><label>Notes<textarea name="notes" rows="3" maxlength="1200" placeholder="Condition, stains, repairs or pickup locality"></textarea></label><label class="spa-check"><input type="checkbox" name="consent" required><span>I agree to be contacted about this booking and understand this is a request, not a confirmed appointment.</span></label><button class="spa-btn" type="submit">Request booking</button><div class="spa-status" role="status" aria-live="polite"></div></form><p class="spa-muted spa-small">Prefer WhatsApp? <a href="https://wa.me/919310729799?text=Hello%20Stroller%20Spa%2C%20I%20would%20like%20to%20book%20a%20service." target="_blank" rel="noopener">Message +91 93107 29799</a></p></aside></div>
  <div id="spa-plans-{{ section.id }}" class="spa-plans"><h2>Travel System Care Memberships</h2><p class="spa-muted">For one registered stroller + infant car seat (0+). Each service visit covers the registered travel system.</p><div class="spa-plan-grid"><article><span class="spa-eyebrow">STANDARD CARE</span><h3>₹12,999</h3><p>4 services · 12 months</p><ul><li>2 Deep Cleaning visits</li><li>2 Essential Cleaning visits</li><li>Worth ₹15,596 · Save ₹2,597</li></ul>{% if section.settings.standard_product != blank %}<a class="spa-btn" href="{{ section.settings.standard_product.url }}">Buy Standard Plan</a>{% else %}<a class="spa-btn" href="https://wa.me/919310729799?text=I%20want%20the%20Standard%20Travel%20System%20Care%20Plan" target="_blank" rel="noopener">Enquire on WhatsApp</a>{% endif %}</article><article class="spa-highlight"><span class="spa-eyebrow">PREMIUM CARE</span><h3>₹18,999</h3><p>6 services · {{ section.settings.premium_months }} months</p><ul><li>4 Deep Cleaning visits</li><li>2 Essential Cleaning visits</li><li>Worth ₹25,994 · Save ₹6,995</li></ul>{% if section.settings.premium_product != blank %}<a class="spa-btn" href="{{ section.settings.premium_product.url }}">Buy Premium Plan</a>{% else %}<a class="spa-btn" href="https://wa.me/919310729799?text=I%20want%20the%20Premium%20Travel%20System%20Care%20Plan" target="_blank" rel="noopener">Enquire on WhatsApp</a>{% endif %}</article></div><p class="spa-muted spa-small">Plans activate after payment confirmation and registration. Repairs, replacement parts, pickup and drop are charged separately. Unused services expire at the end of validity. Please review the full terms before purchase.</p></div>
</section>
<style>
#spa-{{ section.id }}{--navy:#102f58;--teal:#168e96;--pink:#f2749a;--border:#d9e8ef;color:var(--navy);font-family:inherit;max-width:1250px;margin:auto;padding:20px 18px 60px}#spa-{{ section.id }} *{box-sizing:border-box}#spa-{{ section.id }} h1,#spa-{{ section.id }} h2,#spa-{{ section.id }} h3{margin:0 0 12px;color:var(--navy)}#spa-{{ section.id }} h1{font-size:clamp(46px,6vw,78px);letter-spacing:-.05em}#spa-{{ section.id }} h1 em{color:var(--pink);font-style:italic}#spa-{{ section.id }} h2{font-size:28px}#spa-{{ section.id }} p{line-height:1.55}#spa-{{ section.id }} .spa-hero{display:grid;grid-template-columns:1.7fr 1fr;gap:20px;background:linear-gradient(120deg,#eaf8fb,#fff0f4);padding:clamp(25px,5vw,64px);border-radius:25px;align-items:center}#spa-{{ section.id }} .spa-eyebrow{font-size:12px;font-weight:800;letter-spacing:.1em;color:var(--teal)}#spa-{{ section.id }} .spa-hero-art{font-size:55px;text-align:center;background:#fff9;border-radius:30px;padding:15px}#spa-{{ section.id }} .spa-hero-art span{display:block;color:var(--pink)}#spa-{{ section.id }} .spa-hero-links{display:flex;gap:10px;flex-wrap:wrap}#spa-{{ section.id }} .spa-btn{border:0;display:inline-block;background:var(--navy);color:white!important;text-decoration:none;padding:12px 19px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;text-align:center}#spa-{{ section.id }} .spa-btn:hover{background:var(--teal)}#spa-{{ section.id }} .spa-outline{background:white;color:var(--navy)!important;border:1px solid var(--navy)}#spa-{{ section.id }} .spa-features{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;padding:24px 0;font-size:13px;font-weight:700}#spa-{{ section.id }} .spa-layout{display:grid;grid-template-columns:1.45fr 1fr;gap:26px;margin-top:18px}#spa-{{ section.id }} .spa-price-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}#spa-{{ section.id }} .spa-price-grid article,#spa-{{ section.id }} .spa-book,#spa-{{ section.id }} .spa-plan-grid article{border:1px solid var(--border);border-radius:16px;padding:18px;background:white}#spa-{{ section.id }} .spa-price-grid h3{font-size:16px;min-height:35px}#spa-{{ section.id }} .spa-price-grid article div{display:flex;justify-content:space-between;gap:10px;border-top:1px solid #eef2f6;padding:8px 0;font-size:13px}#spa-{{ section.id }} .spa-price-grid strong{text-align:right}#spa-{{ section.id }} .spa-muted{color:#597084;font-size:14px}#spa-{{ section.id }} .spa-small{font-size:12px}#spa-{{ section.id }} .spa-note{margin-top:16px;background:#eaf8fb;border-radius:12px;padding:14px;font-size:13px;line-height:1.6}#spa-{{ section.id }} .spa-book{background:#f7fbfd;align-self:start;position:sticky;top:16px}#spa-{{ section.id }} .spa-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}#spa-{{ section.id }} .spa-form label{font-size:12px;font-weight:700;display:flex;flex-direction:column;gap:5px}#spa-{{ section.id }} .spa-form input,#spa-{{ section.id }} .spa-form select,#spa-{{ section.id }} .spa-form textarea{width:100%;min-width:0;border:1px solid #cad9e2;border-radius:8px;padding:10px;background:white;color:#173451;font:inherit;font-size:14px}#spa-{{ section.id }} .spa-form label:has(textarea),#spa-{{ section.id }} .spa-form .spa-check,#spa-{{ section.id }} .spa-form button,#spa-{{ section.id }} .spa-status{grid-column:1/-1}#spa-{{ section.id }} .spa-form .spa-check{display:flex;flex-direction:row;align-items:flex-start;font-weight:400}#spa-{{ section.id }} .spa-form .spa-check input{width:auto;margin-top:3px}#spa-{{ section.id }} .spa-status{font-size:13px;line-height:1.5}#spa-{{ section.id }} .spa-plans{padding-top:45px}#spa-{{ section.id }} .spa-plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}#spa-{{ section.id }} .spa-plan-grid h3{font-size:36px;margin-top:12px}#spa-{{ section.id }} .spa-plan-grid li{margin:10px 0}#spa-{{ section.id }} .spa-highlight{background:#fef3f6!important;border-color:#f5b3c6!important}@media(max-width:800px){#spa-{{ section.id }} .spa-hero,#spa-{{ section.id }} .spa-layout{grid-template-columns:1fr}#spa-{{ section.id }} .spa-book{position:static}#spa-{{ section.id }} .spa-hero-art{display:none}}@media(max-width:530px){#spa-{{ section.id }} .spa-price-grid,#spa-{{ section.id }} .spa-plan-grid,#spa-{{ section.id }} .spa-form{grid-template-columns:1fr}}
</style>
<script>
(function(){
  const root=document.getElementById('spa-{{ section.id }}');if(!root||root.dataset.bound)return;root.dataset.bound='1';
  const form=root.querySelector('.spa-form'),status=root.querySelector('.spa-status');
  const date=form.querySelector('[name="preferred_date"]');date.min=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);
  form.addEventListener('submit',async function(e){e.preventDefault();if(!form.reportValidity())return;const api=root.dataset.api.trim();if(!api){status.textContent='Online booking is being activated. Please book via WhatsApp at +91 93107 29799.';return;}
    const payload=Object.fromEntries(new FormData(form).entries());payload.source='kidscompany-shopify';payload.consent=!!form.querySelector('[name="consent"]').checked;
    const btn=form.querySelector('button[type="submit"]');btn.disabled=true;status.textContent='Sending booking request…';
    try{const res=await fetch(api.replace(/\/$/,'')+'/api/public/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok)throw new Error(data.error||'Could not submit booking');status.textContent='Request received! Reference: '+data.reference+'. Our team will contact you to confirm.';form.reset();}
    catch(err){status.textContent='Booking could not be submitted: '+err.message+'. Please WhatsApp +91 93107 29799.';}finally{btn.disabled=false;}
  });
})();
</script>
{% schema %}
{"name":"Stroller Spa Booking","tag":"section","settings":[{"type":"text","id":"api_url","label":"Secure booking API URL","info":"HTTPS backend URL; leave blank until backend is deployed"},{"type":"product","id":"standard_product","label":"Standard Travel System membership product"},{"type":"product","id":"premium_product","label":"Premium Travel System membership product"},{"type":"select","id":"premium_months","label":"Premium plan validity","options":[{"value":"15","label":"15 months"},{"value":"18","label":"18 months"}],"default":"18"}],"presets":[{"name":"Stroller Spa Booking"}]}
{% endschema %}
